        <mxCell id="mongo" value="Current application datastore&#xa;MongoDB 7&#xa;Restrict database access to API tasks&#xa;(AWS Mongo-compatible target requires TLS / compatibility validation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f4e8;strokeColor=#69a879;fontSize=12;" vertex="1" parent="data"><mxGeometry x="25" y="95" width="300" height="120" as="geometry" /></mxCell>
