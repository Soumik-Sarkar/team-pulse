        <mxCell id="ecs" value="Amazon ECS Fargate&#xa;Node.js / Express API container&#xa;Identity · Habits · Challenges&#xa;Events · Insights · Recommendations · Notifications&#xa;Private tasks; scale service as needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f4e8;strokeColor=#69a879;fontSize=13;" vertex="1" parent="app"><mxGeometry x="35" y="90" width="495" height="145" as="geometry" /></mxCell>
        <mxCell id="taskroles" value="Least-privilege task roles&#xa;Task security group allows API traffic from ALB only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7f4;strokeColor=#91b49a;fontSize=12;" vertex="1" parent="app"><mxGeometry x="35" y="275" width="495" height="78" as="geometry" /></mxCell>
